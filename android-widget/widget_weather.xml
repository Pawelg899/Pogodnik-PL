<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050B12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#050B12">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/widget_place"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Moja lokalizacja"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"/>
                <TextView
                    android:id="@+id/widget_updated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aktualizacja • 12:40"
                    android:textColor="#9DB1C7"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            <TextView
                android:id="@+id/widget_refresh"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="↻"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:background="@drawable/widget_button"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/widget_icon"
                android:layout_width="wrap_content"
                android:layout_height="62dp"
                android:gravity="center"
                android:text="☁"
                android:textColor="#FFFFFF"
                android:textSize="54sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center">
                <TextView
                    android:id="@+id/widget_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15°"
                    android:textColor="#FFFFFF"
                    android:textSize="50sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="C"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="9dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/widget_condition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pochmurno"
                android:textColor="#F2F6FA"
                android:textSize="17sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:id="@+id/widget_feels"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Odczuwalna 14°C"
                android:textColor="#8FB9E6"
                android:textSize="13sp"
                android:layout_marginTop="1dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="7dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="➤" android:textColor="#FFFFFF" android:textSize="19sp"/>
                <TextView android:id="@+id/widget_wind_detail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="z zachodu&#10;10 km/h" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center"/>
                <TextView android:id="@+id/widget_gust" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Porywy 18 km/h" android:textColor="#8FA8C2" android:textSize="8sp"/>
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="58dp" android:background="#31516D"/>

            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💧" android:textSize="17sp"/>
                <TextView android:id="@+id/widget_rain_detail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0 mm&#10;— 0%" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Opad (1h)" android:textColor="#8FA8C2" android:textSize="8sp"/>
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="58dp" android:background="#31516D"/>

            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="◷" android:textColor="#FFFFFF" android:textSize="19sp"/>
                <TextView android:id="@+id/widget_pressure" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1018 hPa" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ciśnienie" android:textColor="#8FA8C2" android:textSize="8sp"/>
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="58dp" android:background="#31516D"/>

            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💧" android:textSize="17sp"/>
                <TextView android:id="@+id/widget_humidity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="78%" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wilgotność" android:textColor="#8FA8C2" android:textSize="8sp"/>
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="58dp" android:background="#31516D"/>

            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☁" android:textColor="#FFFFFF" android:textSize="19sp"/>
                <TextView android:id="@+id/widget_clouds" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="45%" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Zachmurzenie" android:textColor="#8FA8C2" android:textSize="8sp"/>
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_map_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:background="#081A2B"
            android:padding="2dp">
            <ImageView
                android:id="@+id/widget_radar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Mapa radarowa"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:padding="6dp"
                android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="30dp" android:gravity="center" android:paddingLeft="14dp" android:paddingRight="14dp" android:text="RADAR" android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold" android:background="@drawable/widget_button"/>
                <TextView android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="4dp" android:gravity="center" android:paddingLeft="10dp" android:paddingRight="10dp" android:text="WYŁADOWANIA" android:textColor="#FFFFFF" android:textSize="9sp" android:background="@drawable/widget_bg"/>
                <TextView android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="4dp" android:gravity="center" android:paddingLeft="11dp" android:paddingRight="11dp" android:text="TSP" android:textColor="#FFFFFF" android:textSize="9sp" android:background="@drawable/widget_bg"/>
                <TextView android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="4dp" android:gravity="center" android:paddingLeft="11dp" android:paddingRight="11dp" android:text="SAT" android:textColor="#FFFFFF" android:textSize="9sp" android:background="@drawable/widget_bg"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="6dp"
                android:text="© OpenStreetMap • RainViewer"
                android:textColor="#FFFFFF"
                android:textSize="7sp"
                android:background="#99000000"
                android:padding="2dp"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="128dp"
            android:orientation="vertical"
            android:layout_marginTop="7dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:text="NAJBLIŻSZE DNI  ›"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:id="@+id/day1Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DZIŚ" android:textColor="#9DB1C7" android:textSize="8sp" android:textStyle="bold"/><TextView android:id="@+id/icon1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☁" android:textColor="#FFFFFF" android:textSize="21sp"/><TextView android:id="@+id/max1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/><TextView android:id="@+id/min1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°" android:textColor="#8196AB" android:textSize="9sp"/><TextView android:id="@+id/rain1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--%" android:textColor="#54CFFF" android:textSize="8sp"/></LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:id="@+id/day2Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#9DB1C7" android:textSize="8sp" android:textStyle="bold"/><TextView android:id="@+id/icon2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⛅" android:textColor="#FFFFFF" android:textSize="21sp"/><TextView android:id="@+id/max2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/><TextView android:id="@+id/min2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°" android:textColor="#8196AB" android:textSize="9sp"/><TextView android:id="@+id/rain2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--%" android:textColor="#54CFFF" android:textSize="8sp"/></LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:id="@+id/day3Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#9DB1C7" android:textSize="8sp" android:textStyle="bold"/><TextView android:id="@+id/icon3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌧" android:textColor="#FFFFFF" android:textSize="21sp"/><TextView android:id="@+id/max3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/><TextView android:id="@+id/min3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°" android:textColor="#8196AB" android:textSize="9sp"/><TextView android:id="@+id/rain3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--%" android:textColor="#54CFFF" android:textSize="8sp"/></LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:id="@+id/day4Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#9DB1C7" android:textSize="8sp" android:textStyle="bold"/><TextView android:id="@+id/icon4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⛈" android:textColor="#FFFFFF" android:textSize="21sp"/><TextView android:id="@+id/max4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/><TextView android:id="@+id/min4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°" android:textColor="#8196AB" android:textSize="9sp"/><TextView android:id="@+id/rain4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--%" android:textColor="#54CFFF" android:textSize="8sp"/></LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><TextView android:id="@+id/day5Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#9DB1C7" android:textSize="8sp" android:textStyle="bold"/><TextView android:id="@+id/icon5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☀" android:textColor="#FFFFFF" android:textSize="21sp"/><TextView android:id="@+id/max5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold"/><TextView android:id="@+id/min5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°" android:textColor="#8196AB" android:textSize="9sp"/><TextView android:id="@+id/rain5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--%" android:textColor="#54CFFF" android:textSize="8sp"/></LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>